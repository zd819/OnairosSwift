@@ -18,6 +18,7 @@ BUILD_DIR="$PROJECT_DIR/build"
 OUTPUT_DIR="$PROJECT_DIR/output"
 FRAMEWORK_NAME="OnairosSDK"
 XCFRAMEWORK_NAME="OnairosSwiftSDK"
+SDK_VERSION="${SDK_VERSION:-1.1.8}"
 
 echo -e "${GREEN}=== Building $XCFRAMEWORK_NAME XCFramework (with Static Dependencies) ===${NC}"
 echo "Project directory: $PROJECT_DIR"
@@ -34,8 +35,8 @@ mkdir -p "$OUTPUT_DIR"
 cd "$PROJECT_DIR"
 
 # Function to merge all static libraries for a platform
-# Uses libtool -all_load to preserve ALL Objective-C categories (e.g. AppAuth's
-# OIDAuthorizationService categories that Google Sign-In depends on).
+# Coalesces each architecture with ld -r -all_load so category implementations
+# remain reachable when consumers link without -ObjC.
 merge_static_libraries() {
     local PLATFORM=$1        # e.g., "iphoneos" or "iphonesimulator"
     local DERIVED_DATA=$2    # path to derivedData
@@ -67,8 +68,7 @@ merge_static_libraries() {
 
         # Extract ALL object files from .a archives to ensure Objective-C
         # categories (e.g. AppAuth's OIDAuthorizationService categories) are
-        # preserved. libtool -static with .a inputs can drop unreferenced
-        # category symbols; extracting .o files first forces them all in.
+        # collected before coalescing each architecture below.
         local EXTRACT_DIR="$OUTPUT_LIB.extracted"
         rm -rf "$EXTRACT_DIR"
         mkdir -p "$EXTRACT_DIR"
@@ -93,6 +93,30 @@ merge_static_libraries() {
         local total=$(echo $EXTRACTED_OBJECTS | wc -w | tr -d ' ')
         echo "Extracted $total total object files — repacking with all ObjC categories"
         libtool -static -o "$OUTPUT_LIB" $EXTRACTED_OBJECTS
+
+        # Archive membership alone does not retain Objective-C categories at the
+        # consumer's link step. Coalesce each slice into one relocatable object,
+        # so linking any SDK symbol also brings in AppAuth's iOS categories.
+        # This avoids requiring customers to add -ObjC linker flags.
+        local COALESCED_DIR="$EXTRACT_DIR/coalesced"
+        mkdir -p "$COALESCED_DIR"
+        local COALESCED_LIBS=""
+        local ARCHS=$(lipo -archs "$OUTPUT_LIB")
+        local LINK_PLATFORM="ios"
+        [ "$PLATFORM" = "iphonesimulator" ] && LINK_PLATFORM="ios-simulator"
+        local SDK_RELEASE=$(xcrun --sdk "$PLATFORM" --show-sdk-version)
+        for arch in $ARCHS; do
+            local thin="$COALESCED_DIR/$arch-input.a"
+            if [ "$(echo $ARCHS | wc -w | tr -d ' ')" -gt 1 ]; then
+                lipo "$OUTPUT_LIB" -thin "$arch" -output "$thin"
+            else
+                cp "$OUTPUT_LIB" "$thin"
+            fi
+            xcrun ld -r -arch "$arch" -platform_version "$LINK_PLATFORM" 17.0 "$SDK_RELEASE" -all_load "$thin" -o "$COALESCED_DIR/$arch.o"
+            libtool -static -o "$COALESCED_DIR/$arch.a" "$COALESCED_DIR/$arch.o"
+            COALESCED_LIBS="$COALESCED_LIBS $COALESCED_DIR/$arch.a"
+        done
+        lipo -create $COALESCED_LIBS -output "$OUTPUT_LIB"
         rm -rf "$EXTRACT_DIR"
 
         echo "Created merged library: $OUTPUT_LIB"
